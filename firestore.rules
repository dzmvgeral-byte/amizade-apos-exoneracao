rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Helper Primitives
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { 
      return request.resource.data; 
    }
    function existing() { 
      return resource.data; 
    }
    function isSignedIn() { 
      return request.auth != null; 
    }
    function isAdmin() { 
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email in ['dzmv.geral@gmail.com', 'admin@sabhia.ao']
      ); 
    }

    // Validation for User entity
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 128 &&
             data.role in ['admin', 'editor', 'reader'];
    }

    // Validation for Lead entity
    function isValidLead(data) {
      return data.keys().hasAll(['id', 'fullName', 'phone', 'format', 'status']) &&
             data.id is string && data.id.size() <= 128 &&
             data.fullName is string && data.fullName.size() <= 200 &&
             data.phone is string && data.phone.size() <= 64 &&
             data.format in ['ebook', 'fisico'] &&
             data.status in ['novo', 'contactado', 'pago', 'concluido'];
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
      allow delete: if isAdmin();
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Leads / Orders Collection
    match /leads/{leadId} {
      allow create: if isValidId(leadId) && isValidLead(incoming());
      allow read: if isSignedIn();
      allow update: if isSignedIn() && isValidLead(incoming());
      allow delete: if isSignedIn();
    }

    // Connection Health Check
    match /test/connection {
      allow read: if true;
    }
  }
}
